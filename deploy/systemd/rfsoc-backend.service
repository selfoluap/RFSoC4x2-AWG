[Unit]
Description=RFSoC AWG Backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/xilinx/RFSoC4x2-AWG
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash -lc 'source /etc/profile.d/pynq_venv.sh && source /etc/profile.d/xrt_setup.sh && uvicorn backend.backend:app --host 127.0.0.1 --port 8001'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
